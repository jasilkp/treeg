# Example environment variables (do NOT commit real secrets)
# Copy these values into Render.com Environment Variables or your local .env

SECRET_KEY=generate_a_random_secret_key_here
DEBUG=False

# Neon.tech PostgreSQL connection string (with ?sslmode=require)
DATABASE_URL=postgresql://neondb_owner:your_password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require

# Allowed hosts and CSRF origins for Render
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.onrender.com

